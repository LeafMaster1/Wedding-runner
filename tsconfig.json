{
     "extends": "./.svelte-kit/tsconfig.json",
         "compilerOptions": {
             "target": "ESNext",
             "module": "ESNext",
             "moduleResolution": "bundler",
             "allowJs": true,
             "checkJs": false,
             "strict": true,
            "noEmit": true,
            "skipLibCheck": true,
            "isolatedModules": true
        },
        "include": [
            "src/**/*.ts",
            "src/**/*.js",
            "src/**/*.svelte",
            ".svelte-kit/ambient.d.ts"
        ]
}